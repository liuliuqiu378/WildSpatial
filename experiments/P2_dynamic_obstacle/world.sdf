<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    This document was autogenerated by xacro from /home/hmn-cjy/liuliuqiu/WildSpatial/data/gz_models/worlds/dynamic_pedestrian.sdf.xacro | -->
<!-- |    EDITING THIS FILE BY HAND IS NOT RECOMMENDED                                 | -->
<!-- =================================================================================== -->
<sdf version="1.6">
  <!-- 行人终点 Y -->
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- ⚠️ TrajectoryFollower 必须挂在 model 内（挂 world 会报 No <link_name>） -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <scene>
      <shadows>0</shadows>
    </scene>
    <physics name="3ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <!-- TB3 世界（含迷宫墙） -->
    <model name="turtlebot3_world">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_world</uri>
      </include>
    </model>
    <!-- ============ 动态行人：VelocityControl 驱动（持续 Y 速度）============ -->
    <!-- 为什么用 VelocityControl：TrajectoryFollower 受物理约束不动；   -->
    <!-- VelocityControl 直接给刚体施加速度 → 稳定产生"横穿行人"。      -->
    <!-- 行人放在机器人前方的开阔区（避开迷宫墙），沿 +Y 滑行穿过视野 -->
    <model name="pedestrian">
      <pose>1.2 -1.5 0.45 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>60</mass>
          <inertia>
            <ixx>6</ixx>
            <iyy>6</iyy>
            <izz>6</izz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e4</kp>
                <kd>1</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- VelocityControl：持续施加速度（initial_linear 给初速，无摩擦时近似匀速滑行） -->
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>body</link_name>
        <initial_linear>0 0.5 0</initial_linear>
      </plugin>
    </model>
    <!-- 第二个行人（反向横穿，演示多动态障碍） -->
    <model name="pedestrian2">
      <pose>2.0 1.5 0.45 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>60</mass>
          <inertia>
            <ixx>6</ixx>
            <iyy>6</iyy>
            <izz>6</izz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.15 0.35 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>body</link_name>
        <initial_linear>0 -0.5 0</initial_linear>
      </plugin>
    </model>
  </world>
</sdf>
