<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    P2 感知实验台：开阔广场 + 动态行人（动态避障专用世界）

    为什么新建（而不是用 tb3_sandbox）：
      tb3_sandbox 是**密集网格墙**（墙间距仅 1.1m），机器人一动就撞墙，
      无法演示"自由巡逻 + 遇人绕行"。本世界只留**四周外墙**，中间开阔，
      让机器人能真实地"边走边避障"。

    布局：
      · 四周外墙围成 10m×10m 开阔场地
      · 中央放 1 个静态柱子（让场景有几何参考）
      · 2 个行人沿 Y 方向横穿（VelocityControl 驱动）
      · 机器人在开阔区巡逻
  -->
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="light" default="0.8"/>
  <xacro:arg name="ped_speed" default="0.45"/>

  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <xacro:unless value="$(arg headless)">
      <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    </xacro:unless>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name='sun' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>$(arg light) $(arg light) $(arg light) 1</diffuse>
      <specular>$(arg light) $(arg light) $(arg light) 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular></material>
        </visual>
      </link>
    </model>

    <scene><shadows>0</shadows></scene>
    <physics name='3ms' type='ode'>
      <max_step_size>0.003</max_step_size><real_time_factor>1</real_time_factor>
    </physics>

    <!-- ===== 四周外墙（围成 10m×10m 开阔场地）===== -->
    <model name="wall_n"><static>1</static><link name="l">
      <pose>0 5.0 0.5 0 0 0</pose>
      <collision name="c"><geometry><box><size>10 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.2 1</size></box></geometry>
        <material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="wall_s"><static>1</static><link name="l">
      <pose>0 -5.0 0.5 0 0 0</pose>
      <collision name="c"><geometry><box><size>10 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.2 1</size></box></geometry>
        <material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="wall_e"><static>1</static><link name="l">
      <pose>5.0 0 0.5 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 10 1</size></box></geometry>
        <material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="wall_w"><static>1</static><link name="l">
      <pose>-5.0 0 0.5 0 0 0</pose>
      <collision name="c"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 10 1</size></box></geometry>
        <material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
    </link></model>

    <!-- ===== 中央两个静态柱子（几何参考）===== -->
    <model name="pillar_a"><static>1</static><link name="l">
      <pose>-1.5 -1.5 0.5 0 0 0</pose>
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        <material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
    </link></model>
    <model name="pillar_b"><static>1</static><link name="l">
      <pose>1.5 1.5 0.5 0 0 0</pose>
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        <material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
    </link></model>

    <!-- ===== 动态行人（VelocityControl 驱动，无摩擦滑行）===== -->
    <model name="pedestrian">
      <pose>0.0 -2.2 0.45 0 0 0</pose>
      <link name="body">
        <inertial><mass>60</mass><inertia><ixx>6</ixx><iyy>6</iyy><izz>6</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
            <contact><ode><kp>1e4</kp><kd>1</kd></ode></contact></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <material><diffuse>0.85 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <link_name>body</link_name>
        <initial_linear>0 $(arg ped_speed) 0</initial_linear>
      </plugin>
    </model>

    <model name="pedestrian2">
      <pose>1.2 2.2 0.45 0 0 0</pose>
      <link name="body">
        <inertial><mass>60</mass><inertia><ixx>6</ixx><iyy>6</iyy><izz>6</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <material><diffuse>0.15 0.35 0.85 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <link_name>body</link_name>
        <initial_linear>0 -$(arg ped_speed) 0</initial_linear>
      </plugin>
    </model>

  </world>
</sdf>
